#!/bin/sh
# The smoke tier (under 60 s): every test marked smoke - imports, shipped config, help.yaml and keymap
# against the parsers, the arm link, the agent verbs and live C. It gates a landing; the full suite
# runs in CI and never blocks. Sibling checkouts of mhseals_hardware and mhseals_nav are used when
# present, else those beside the main clone (a worktree; MHSEALS_HARDWARE / MHSEALS_NAV override). Extra
# arguments go to pytest.
#   tools/smoke --impact   only the smoke tests of the files timpact selects against origin/main (ALL: the full smoke)
# With the workspace agent tools (MHSEALS_AGENTS, else mhseals_agents beside the main checkout), a tree that
# already passed is not run again (tcache, tier smoke or smoke-impact-<sum of the selection>; not with extra
# pytest arguments); MHSEALS_SMOKE_UNCACHED=1 skips that. Their quarantine plugin rides along (the root conftest.py).
# Standalone, as CI runs it: outside CI the tests run in a copy of this tree (tracked and untracked files) under
# $TMPDIR, with no astro_dock workspace, mhseals_agents or caller PYTHONPATH around it, so a local green is CI's
# green (11-04: tests that read the workspace passed here and failed on every push). MHSEALS_STANDALONE=0 runs in place.
here=$(cd "$(dirname "$0")/.." && pwd)
src=$(dirname "$here")
impact=
[ "$1" = --impact ] && impact=1 && shift
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=$here/.git
# a worktree whose siblings are not the workspace's checkouts uses those beside the main clone
[ -d "$src/mhseals_hardware/mhseals_hardware" ] || src=$(dirname "$(dirname "$common")")
agents=${MHSEALS_AGENTS:-$(dirname "$(dirname "$common")")/mhseals_agents}
selected=${MHSEALS_SMOKE_SELECTED:-ALL}
if [ -n "$impact" ] && [ -z "$MHSEALS_SMOKE_SELECTED" ] && [ -x "$agents/tools/timpact" ]; then
    selected=$("$agents/tools/timpact" --repo "$here") || selected=ALL
fi
if [ -z "$MHSEALS_SMOKE_UNCACHED" ] && [ $# -eq 0 ] && [ -x "$agents/tools/tcache" ]; then
    export MHSEALS_SMOKE_UNCACHED=1
    # an impact run is cached under its selection: the same tree can select differently (base, timpact)
    tier=smoke; [ -n "$impact" ] && tier=smoke-impact-$(printf '%s\n' "$selected" | cksum | cut -d' ' -f1)
    exec "$agents/tools/tcache" run --repo "$here" --tier "$tier" -- "$here/tools/smoke" ${impact:+--impact}
fi
hardware=${MHSEALS_HARDWARE:-$src/mhseals_hardware}
export MHSEALS_NAV="${MHSEALS_NAV:-$src/mhseals_nav}"
if [ -z "$CI" ] && [ "${MHSEALS_STANDALONE:-1}" != 0 ]; then
    absolute() { case $1 in /*) echo "$1" ;; *) echo "$PWD/$1" ;; esac; }
    copy=$(mktemp -d "${TMPDIR:-/tmp}/mhseals-smoke.XXXXXX") || exit 1
    trap 'rm -rf "$copy"' EXIT INT TERM
    (cd "$here" && git ls-files -z -co --exclude-standard | tar --null --ignore-failed-read -T - -cf - 2>/dev/null) |
        tar -xf - -C "$copy" || exit 1
    # a git checkout like CI's (some tests read git), committed with no hooks or user config
    git -C "$copy" init -q && git -C "$copy" add -A &&
        git -C "$copy" -c core.hooksPath=/dev/null -c user.name=smoke -c user.email=smoke@localhost \
            commit -qm smoke --no-verify || exit 1
    env -u PYTHONPATH -u ASTRO_WS -u ASTRO_REGISTRY -u BOAT_SIM_SRC -u BOAT_PREVIEW_SRC \
        MHSEALS_STANDALONE=0 MHSEALS_SMOKE_UNCACHED=1 MHSEALS_AGENTS="$copy/.no-agents" \
        MHSEALS_SMOKE_SELECTED="$selected" MHSEALS_HARDWARE="$(absolute "$hardware")" \
        MHSEALS_NAV="$(absolute "$MHSEALS_NAV")" "$copy/tools/smoke" ${impact:+--impact} "$@"
    exit $?
fi
export PYTHONPATH="$here:$hardware:$MHSEALS_NAV${PYTHONPATH:+:$PYTHONPATH}"
[ "$(basename "$agents")" = mhseals_agents ] && [ -d "$agents" ] && PYTHONPATH="$PYTHONPATH:$(dirname "$agents")"
cd "$here" || exit 1
if [ -n "$impact" ]; then
    if ! printf '%s\n' "$selected" | grep -qx ALL; then
        tests=$(printf '%s\n' "$selected" | grep '^test/.*\.py$')
        [ -z "$tests" ] && echo 'no affected tests' && exit 0
        # the smoke tests of those files (the full suite is CI's); none selected (exit 5) is a pass
        # shellcheck disable=SC2086 - one repo-relative test file per line, no spaces
        python3 -m pytest -q -m smoke -p no:cacheprovider $tests "$@"
        rc=$?; [ "$rc" = 5 ] && rc=0; exit "$rc"
    fi
fi
exec python3 -m pytest -q -m smoke -p no:cacheprovider test "$@"
