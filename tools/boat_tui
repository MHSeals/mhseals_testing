#!/bin/sh
# boat_tui [--session S] [--container C] [--jump J] up|view|restart|status ...: boat_test in tmux, for the operator and agents.
#   up [-- ARGS]   start the stack and TUI in tmux session S (default boat), or reuse it; prints the one attach line
#   view [NAME]    a viewer (boat_test --view) in session S-NAME (first free v1..v9); attaches on a tty
#   restart        a new TUI takes over the old one's pane (neutral, disarmed); the stack and keepers keep running
#   status         tmux sessions and who controls (harness/control.py)
#   host           the TUI host from the vessel registry (ssh "$(boat_tui host)" ... from the station)
#   sim [up] [--seed N] | sim down   the headless Unity sim, then boat_test crane_full_stack in session sim (tools/boat_sim)
#   preview [up] [REF] [--headless] | preview down|attach|restart|status   the owner's preview of REF (default origin/main):
#                  its own snapshot, build, container and tmux -L preview, the player windowed (tools/boat_preview)
# Run it on the TUI host (the registry's tui_backend, else boat_computer host; or the sim host): from the station,
#   ssh TUI_HOST ~/astro_dock/src/mhseals_testing/tools/boat_tui up
# C is the container boat_test runs in (the registry's dev container; the sim's in sim; '' runs it here). J adds -J J to the
# printed ssh line (a jump host, when the station does not route the boat LAN itself). Quit with q in the TUI:
# killing tmux skips the session's close (neutral, disarm, bag flush). Agents arm with boat_agent arm.
# Every tmux call goes to its own server (socket BOAT_TUI_SOCKET, default boat: tmux -L boat), never the caller's
# ($TMUX is cleared), so nothing here can reach another tmux server on the host.
set -eu
# picked: C was given (BOAT_TUI_CONTAINER or --container, '' included); else the registry's, and none found refuses
session=boat container=${BOAT_TUI_CONTAINER-} picked=${BOAT_TUI_CONTAINER+1} jump=${BOAT_TUI_JUMP-} socket=${BOAT_TUI_SOCKET:-boat}
while [ $# -gt 0 ]; do
    case $1 in
        --session) session=$2; shift 2 ;;
        --container) container=$2 picked=1; shift 2 ;;
        --jump) jump=$2; shift 2 ;;
        --start-stack) echo 'boat_tui: --start-stack was removed: start the stack in the TUI, Status panel, Components, Enter on the Stack row' >&2; exit 2 ;;
        *) break ;;
    esac
done
verb=${1:-}; [ $# -gt 0 ] && shift
command -v tmux >/dev/null || { echo "boat_tui: tmux is not installed on $(uname -n)" >&2; exit 1; }
outer=${TMUX:-}     # attaching from inside a tmux client would nest
unset TMUX TMUX_PANE
t() { command tmux -L "$socket" "$@"; }

q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
host=$(uname -n); host=${host%%.*}
ssh_client=${SSH_CLIENT:-}; from=${ssh_client%% *}; from=${from:-$host}; from=${BOAT_AGENT:+$BOAT_AGENT@}$from

# What the pane knows about its terminal, handed into the container (docker exec drops it; a bare -e passes
# only what is set): TERM picks the colours (tmux-256color, not docker's 16-colour xterm), TERM_PROGRAM=tmux
# tells the image probe it runs under a tmux it can't ask, NO_COLOR and MHS_ASCII keep the text fallbacks.
hints=''
for name in TERM TERM_PROGRAM TERM_PROGRAM_VERSION KITTY_WINDOW_ID NO_COLOR MHS_ASCII; do hints="$hints -e $name"; done

# The command line that runs boat_test with ARGS in the container (or here), as client $1.
run() {
    client=$1; shift
    args=''; for arg in "$@"; do args="$args $(q "$arg")"; done
    if [ -n "$container" ]; then
        inner=". /opt/ros/\$ROS_DISTRO/setup.bash && . install/setup.bash && exec ros2 run mhseals_testing boat_test$args"
        printf 'docker exec -it%s -e BOAT_TUI_CLIENT=%s -e BOAT_TUI_FROM=%s %s bash -c %s' "$hints" \
            "$(q "$client")" "$(q "$from")" "$(q "$container")" "$(q "$inner")"
    else
        printf 'BOAT_TUI_CLIENT=%s BOAT_TUI_FROM=%s exec boat_test%s' "$(q "$client")" "$(q "$from")" "$args"
    fi
}

attach_line() {
    if [ -n "${SSH_CONNECTION:-}" ] || [ -n "$jump" ]; then
        # tmux by its path here: ssh runs a non-login shell, whose PATH may lack it (a ~/.local/bin tmux)
        echo "ssh -t ${jump:+-J $jump }$host $(command -v tmux) -L $socket attach -t $1"
    else
        echo "tmux -L $socket attach -t $1"
    fi
}

# Kitty's images and manual's key-event request reach the operator's terminal through tmux's passthrough, and
# focus reports reach the TUI (losing focus stops manual driving): on for this server only.
passthrough() {
    t set-option -g allow-passthrough on >/dev/null 2>&1 || true     # tmux before 3.3 has no such option
    t set-option -g focus-events on >/dev/null 2>&1 || true
}

# start NAME CMD: a detached session that keeps a failed pane, so a startup error stays readable.
start() {
    t new-session -d -s "$1" -x 200 -y 50
    t set-option -t "$1" remain-on-exit on >/dev/null
    passthrough
    t respawn-pane -k -t "$1" "$2"
    sleep "${BOAT_TUI_START_S:-3}"
    if [ "$(t display-message -p -t "$1" '#{pane_dead}')" = 1 ]; then
        echo "boat_tui: boat_test in $1 exited at start:" >&2
        # -S -: the scrollback too (a TUI clears the screen before its error is the last thing left), -J: joined
        t capture-pane -p -J -S - -t "$1" | grep -v '^$' | tail -n "${BOAT_TUI_FAIL_LINES:-60}" >&2
        t kill-session -t "$1"
        exit 1
    fi
}

# =NAME: matches only NAME (never NAME-v1); the trailing : makes it a pane target, without which display-message prints
# nothing and a dead pane counted as running.
alive() { t has-session -t "=$1" 2>/dev/null && [ "$(t display-message -p -t "=$1:" '#{pane_dead}')" != 1 ]; }

case $verb in up|view|restart|status)
    [ -n "$picked" ] || container=$(. "$(dirname "$0")/registry.sh"; dev_container) || container=''
    [ -n "$picked$container" ] || { echo "boat_tui: no dev container (the registry's defaults.container, read by tools/registry.sh dev_container); set BOAT_TUI_CONTAINER, or --container '' to run here" >&2; exit 4; }
esac
case $verb in
    up)
        [ "${1:-}" = -- ] && shift
        if alive "$session"; then
            passthrough
            echo "boat_tui: $session already runs on $host; attach:" >&2
        else
            t kill-session -t "=$session" 2>/dev/null || true      # a pane left dead by an earlier exit
            start "$session" "$(run "$session" "$@")"
            saved=''; for arg in "$@"; do saved="$saved $(q "$arg")"; done
            t set-environment -t "$session" BOAT_TUI_ARGS "$saved"     # the viewers' boat_test args, quoted
            echo "boat_tui: boat_test runs in tmux session $session on $host; attach:" >&2
        fi
        attach_line "$session"
        ;;
    view)
        alive "$session" || { echo "boat_tui: no $session session on $host (boat_tui up starts one)" >&2; exit 4; }
        name=${1:-}
        if [ -z "$name" ]; then
            for n in 1 2 3 4 5 6 7 8 9; do alive "$session-v$n" || { name=v$n; break; }; done
        fi
        view="$session-$name"
        if ! alive "$view"; then
            t kill-session -t "=$view" 2>/dev/null || true
            saved=$(t show-environment -t "$session" BOAT_TUI_ARGS 2>/dev/null | sed -n 's/^BOAT_TUI_ARGS=//p')
            eval "set -- $saved"                                       # our own quoting, from up
            start "$view" "$(run "$view" "$@" --view)"
        fi
        if [ -t 0 ] && [ -t 1 ] && [ -z "$outer" ]; then exec tmux -L "$socket" attach -t "$view"; fi
        echo "boat_tui: viewer $view on $host; attach:" >&2
        attach_line "$view"
        ;;
    restart)
        # A new boat_test --take beside the old one: the old hands over (neutral, disarmed) and comes back as a
        # viewer, the stack and keepers stay up and are adopted; then the old window (now a viewer) goes.
        alive "$session" || { echo "boat_tui: no $session session on $host (boat_tui up starts one)" >&2; exit 4; }
        old=$(t display-message -p -t "=$session:" '#{window_id}')
        [ -n "$old" ] || { echo "boat_tui: cannot find the $session window" >&2; exit 1; }
        saved=$(t show-environment -t "$session" BOAT_TUI_ARGS 2>/dev/null | sed -n 's/^BOAT_TUI_ARGS=//p')
        eval "set -- $saved"
        new=$(t new-window -d -P -F '#{window_id}' -t "=$session:" "$(run "$session" "$@" --take)")
        t set-option -w -t "$new" remain-on-exit on >/dev/null
        waited=0
        handed() {
            [ "$(t display-message -p -t "$old" '#{pane_dead}' 2>/dev/null || echo 1)" = 1 ] ||
                t capture-pane -p -t "$old" 2>/dev/null | grep -q 'Control taken by'
        }
        until handed; do
            [ "$waited" -ge "${BOAT_TUI_HANDOVER_S:-30}" ] && {
                echo "boat_tui: the old TUI did not hand over in ${BOAT_TUI_HANDOVER_S:-30} s; both windows kept" >&2
                exit 1; }
            sleep 1; waited=$((waited + 1))
        done
        t select-window -t "$new"
        t kill-window -t "$old" 2>/dev/null || true
        echo "boat_tui: boat_test restarted in $session on $host (the stack kept running); attach:" >&2
        attach_line "$session"
        ;;
    preview)
        # boat_tui preview [REF] [--headless] | preview down|attach|restart|status: agents never (the agent hook)
        # an explicit up is the default verb, never a REF (preview up took "up" as the ref: a fresh cache and build)
        [ "${1:-}" = up ] && shift
        case ${1:-} in
            down|attach|restart|status) exec "$(dirname "$0")/boat_preview" "$@" ;;
            *) exec "$(dirname "$0")/boat_preview" up "$@" ;;
        esac
        ;;
    sim)
        # boat_tui sim [--seed N] [--unguarded] [--dry-run] | sim down | sim status: the headless Unity sim and boat_test on it
        [ "${1:-}" = up ] && shift
        case ${1:-} in down|status) exec "$(dirname "$0")/boat_sim" "$@" ;; *) exec "$(dirname "$0")/boat_sim" up "$@" ;; esac
        ;;
    host)
        . "$(dirname "$0")/registry.sh"
        tui_host || { echo 'boat_tui: no tui_backend or boat_computer host in the vessel registry (hw.sh whoami --registry)' >&2; exit 2; }
        ;;
    status)
        t list-sessions -F '#{session_name}  #{?pane_dead,exited,running}  #{session_attached} attached' 2>/dev/null \
            | grep -E "^$session(-|  )" || echo "no $session sessions on $host"
        if [ -n "$container" ]; then
            docker exec -i "$container" bash -c \
                '. /opt/ros/$ROS_DISTRO/setup.bash && . install/setup.bash && exec python3 -m mhseals_testing.harness.control'
        else
            python3 -m mhseals_testing.harness.control
        fi
        ;;
    *)
        . "$(dirname "$0")/registry.sh"
        tui=$(tui_host) || tui=TUI_HOST        # filled from the vessel registry
        sed -n '2,15s/^# \{0,1\}//p' "$0" | sed "s/TUI_HOST/$tui/g"; [ -z "$verb" ] || exit 2 ;;
esac
