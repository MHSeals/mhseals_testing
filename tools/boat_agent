#!/bin/sh
# boat_agent VERB ...: boat_trial's agent verbs inside the dev container, one SSH hop from the dev
# machine, called from the boat host's checkout: ssh blastoise-odroid ~/astro_dock/src/mhseals_testing/tools/boat_agent status
# With $BOAT_AGENT_TARGET naming another host (a boat session sets it), this checkout makes that hop itself and
# remembers the last operator state, so a boat that is off or out of reach answers `unreachable` with it
# (harness/agent_relay.py, host python3, no container).
# File verbs load no rclpy; stop's backup path does.
target=${BOAT_AGENT_TARGET:-local}
[ "$target" = blastoise ] && target=blastoise-odroid
here=$(hostname)
if [ "$target" != local ] && [ "$target" != "$here" ] && [ "$target" != "${here%%.*}" ]; then
  PYTHONPATH="$(cd "$(dirname "$0")/.." && pwd)${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m mhseals_testing.harness.agent_relay "$target" "$@"
fi
exec docker exec -i roboboat_dev bash -c \
  '. /opt/ros/jazzy/setup.bash && . install/setup.bash && exec python3 -m mhseals_testing.harness.cli "$@"' \
  _ "$@"
