#!/usr/bin/env bash
# boat_sim [up [--seed N] [--build] [--no-player] [--dry-run] | down | status]: the headless Unity sim and boat_test on it.
#   up      ONE heavy-unity job (stack.yaml heavy, unity slot): a fresh private-IPC container (config
#           sim/stack.yaml container), a free ROS_DOMAIN_ID (domains, localhost; endpoint port 10000 + it), boat_test --profile
#           crane_full_stack in tmux -L boat session sim (it starts the stack and the ROS-TCP endpoint), then the
#           player headless under xvfb-run with the course of SEED. Waits for down (or max_s) and tears down.
#           --build refreshes the overlay from the workspace checkouts (built on /opt/ros alone at stack.yaml
#           mount; the first up builds it); --dry-run prints the plan. --no-player: the stack and TUI alone, a heavy
#           sim job (the TUI, its verbs and help while the unity slots are busy; nothing moves the boat).
#   down    stop the TUI session, the player and the container (exact PIDs) and give the slot back; a session
#           still queued for the slot is cancelled
#   status  the domain, the player and the TUI session
# Settings: config/sim/stack.yaml, each overridable as BOAT_SIM_<KEY> (BOAT_SIM_PLAYER=/path/CRANE.x86_64).
# Never opens a window; tmux only on its own server (-L boat, $TMUX cleared). tools/boat_tui sim runs this.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
# SIM_SRC: the workspace src/ of this checkout (of its main checkout when this is a worktree; BOAT_SIM_SRC);
# SIM_WORKSPACE its astro_dock. up resolves the rest from the workspace (resolved below): docs/preview.md
settings=$(python3 -m mhseals_testing.harness.sim_stack env) || exit 2
eval "$settings"
resolved() { settings=$(python3 -m mhseals_testing.harness.sim_stack env --resolve "$@") || exit 2; eval "$settings"; }
SRC=$SIM_SRC
HEAVY=$SIM_HEAVY      # stack.yaml heavy (BOAT_SIM_HEAVY): this host's heavy-job guard, never guessed
RUN=$SIM_RUN; mkdir -p "$RUN"
DOMAINS=/tmp/boat-sim-$(id -u); mkdir -p "$DOMAINS"; chmod 700 "$DOMAINS"
t() { env -u TMUX -u TMUX_PANE tmux -L boat "$@"; }

cenv() {   # the stack's environment inside the container
  echo "export HOME=$SIM_MOUNT/home ROS_DOMAIN_ID=$DOMAIN ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
MHSEALS_DATA=$SIM_MOUNT/data MHSEALS_HARDWARE_CONFIG=$SIM_MOUNT/src/mhseals_testing/config/sim/hardware_crane.yaml \
MHSEALS_SIM_ARM=1 TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8; source /opt/ros/\$ROS_DISTRO/setup.bash; \
source $SIM_MOUNT/install/local_setup.bash"
}

container_up() {
  docker stop -t 10 "$SIM_CONTAINER" >/dev/null 2>&1 || true      # a fresh stack: no old processes or holds
  mkdir -p "$SIM_OVERLAY/src" "$SIM_OVERLAY/home" "$SIM_OVERLAY/data"      # ours, before docker would make it as root
  # a container on another image than the workspace's (a pull since) is made again: never an old /opt/ros
  if [ "$(docker inspect --format '{{.Image}}' "$SIM_CONTAINER" 2>/dev/null)" != "$(docker image inspect --format '{{.Id}}' "$SIM_IMAGE")" ]; then
    docker rm -f "$SIM_CONTAINER" >/dev/null 2>&1 || true
  fi
  if ! docker inspect "$SIM_CONTAINER" >/dev/null 2>&1; then
    docker run -d --name "$SIM_CONTAINER" --label boat.sim=1 --init --ipc private --network host \
      -e BASH_ENV= --user roboboat -v "$SIM_OVERLAY:$SIM_MOUNT" --entrypoint sleep "$SIM_IMAGE" infinity >/dev/null
  fi
  docker start "$SIM_CONTAINER" >/dev/null
  docker exec "$SIM_CONTAINER" bash -c 'f=/tmp/mhseals-$(id -u)/session.json; [ -e $f ] && mv $f $f.stale-$(date +%s) || true'
}

overlay() { # --build (or no install yet): the workspace checkouts of its manifest, built by hw.sh build on /opt/ros alone
  local p
  for p in $SIM_REPOS; do
    rsync -a --delete --exclude .git --exclude __pycache__ "$SRC/${p%%=*}/" "$SIM_OVERLAY/src/${p%%=*}/"
  done
  ASTRO_BUILD_CLEAN_UNSTAMPED=1 "$SIM_WORKSPACE/hw.sh" build --ws "$SIM_MOUNT" --container "$SIM_CONTAINER"
}

endpoint_port() { # the endpoint on this session's port (sim_stack.endpoint_port of its domain; symlink-installed)
  local file=$SIM_OVERLAY/src/mhseals_nav/config/endpoint_startup.yaml
  sed -i -E "s/^(unity: \{ip: [0-9.]+, port: )[0-9a-z]+\}/\1$SIM_PORT}/" "$file"
  grep -q "port: $SIM_PORT}" "$file" || { echo "boat_sim: cannot set the endpoint port in $file" >&2; exit 1; }
}

tui() {    # boat_test in the boat tmux server; it starts the profile's components (the endpoint among them)
  t kill-session -t "=$SIM_TMUX_SESSION" 2>/dev/null || true
  t new-session -d -s "$SIM_TMUX_SESSION" -x 200 -y 55 \
    "docker exec -it $SIM_CONTAINER bash -c '$(cenv); exec ros2 run mhseals_testing boat_test --profile $SIM_PROFILE --set command_mode=$SIM_COMMAND_MODE'; sleep 600"
}

player() { # headless (xvfb, never -nographics), the course of SEED; its truth beside the run
  rm -f "$RUN/course_truth.json" "$RUN/player.log"
  ( exec xvfb-run -a -s "-screen 0 1280x720x24" nice -n 19 "$SIM_PLAYER" \
      -screen-fullscreen 0 -screen-width 1280 -screen-height 720 -logFile "$RUN/player.log" \
      --crane-profile interactive-low --crane-scene "Roboboat Course" \
      --crane-ros-ip 127.0.0.1 --crane-ros-port "$SIM_PORT" \
      --crane-disable-sitl --crane-ros-thruster-pwm --crane-roboboat-contract --crane-ros-nav-state \
      --crane-lidar-returns-only --crane-lidar-water-level 0.02 \
      --crane-course-family "$SIM_COURSE_FAMILY" --crane-course-seed "$SEED" \
      --crane-roboboat-course-truth "$RUN/course_truth.json" ) >"$RUN/player-stdout.log" 2>&1 &
  echo $! > "$RUN/player.pid"
  local waited=0
  until grep -q CRANE_ROBOBOAT_COURSE_READY "$RUN/player.log" 2>/dev/null; do
    [ "$waited" -ge "$SIM_READY_S" ] && { echo "boat_sim: player not ready in $SIM_READY_S s, see $RUN/player.log" >&2; exit 1; }
    sleep 2; waited=$((waited + 2))
  done
}

down() {
  # a session still queued for the slot (no domain yet) is cancelled, or it would start once the slot frees
  if [ -s "$RUN/queued.pid" ] && [ ! -s "$RUN/domain" ]; then
    pg=$(cat "$RUN/queued.pid")
    [ "$(ps -o pgid= -p $$ | tr -d ' ')" != "$pg" ] && kill -TERM -- "-$pg" 2>/dev/null || true
  fi
  rm -f "$RUN/queued.pid"
  t kill-session -t "=$SIM_TMUX_SESSION" 2>/dev/null || true
  if [ -s "$RUN/player.pid" ]; then     # xvfb-run's pid: its children first, then itself
    pid=$(cat "$RUN/player.pid")
    for c in $(pgrep -P "$pid" 2>/dev/null) "$pid"; do kill -0 "$c" 2>/dev/null && kill -TERM "$c" || true; done
    rm -f "$RUN/player.pid"
  fi
  docker stop -t 15 "$SIM_CONTAINER" >/dev/null 2>&1 || true
  [ -s "$RUN/domain" ] && rm -f "$DOMAINS/domain.$(cat "$RUN/domain")"
  rm -f "$RUN/domain"; touch "$RUN/stop"
  echo "boat_sim: down"
}

session() {
  trap down EXIT; trap 'exit 143' INT TERM
  rm -f "$RUN/stop"
  resolved --pull       # the workspace's image, pulled first when the registry has a newer one
  DOMAIN=$(python3 -m mhseals_testing.harness.sim_stack domain)
  echo "$$" > "$DOMAINS/domain.$DOMAIN"; echo "$DOMAIN" > "$RUN/domain"
  SIM_PORT=$(python3 -m mhseals_testing.harness.sim_stack port "$DOMAIN")
  container_up
  # built elsewhere (another mount: its setup files name that prefix) or never: build here
  if [ "$BUILD" = 1 ] || ! grep -qF "$SIM_MOUNT/install" "$SIM_OVERLAY/install/setup.sh" 2>/dev/null; then overlay; fi
  endpoint_port
  tui
  until docker exec "$SIM_CONTAINER" pgrep -f default_server_endpoint >/dev/null; do sleep 5; done
  sleep 10                               # the endpoint listens on the port
  [ "$PLAYER" = 1 ] && player
  echo "boat_sim: ready, domain $DOMAIN, seed $SEED; attach: tmux -L boat attach -t $SIM_TMUX_SESSION"
  local end=$(( $(date +%s) + SIM_MAX_S ))
  while [ ! -e "$RUN/stop" ] && [ "$(date +%s)" -lt "$end" ]; do sleep 5; done
}

verb=${1:-}; [ $# -gt 0 ] && shift
SEED=$SIM_SEED; dry=0; BUILD=0; PLAYER=1
while [ $# -gt 0 ]; do
  case $1 in --seed) SEED=$2; shift 2 ;; --dry-run) dry=1; shift ;; --build) BUILD=1; shift ;; --no-player) PLAYER=0; shift ;; *) break ;; esac
done
case $verb in
  up)
    [ "$PLAYER" = 0 ] || [ -x "$SIM_PLAYER" ] || { echo "boat_sim: no player at $SIM_PLAYER; install the crane_ml player there, or set BOAT_SIM_PLAYER=/path/CRANE.x86_64 (config/sim/stack.yaml player)" >&2; exit 2; }
    resolved
    if [ "$dry" = 1 ]; then
      echo "boat_sim: would run under $HEAVY $([ "$PLAYER" = 1 ] && echo unity || echo sim): container $SIM_CONTAINER ($SIM_IMAGE), a free domain in" \
           "$SIM_DOMAINS, boat_test --profile $SIM_PROFILE in tmux -L boat session $SIM_TMUX_SESSION, player $([ "$PLAYER" = 1 ] && echo "$SIM_PLAYER" || echo none)" \
           "headless with $SIM_COURSE_FAMILY seed $SEED, port 10000 + domain, repos $SIM_REPOS built by $SIM_WORKSPACE/hw.sh build; logs in $RUN"
      exit 0
    fi
    # the stop file stays until this session starts: a session still ending sees it and gives the slot back
    build=''; [ "$BUILD" = 1 ] && build=--build
    slot=unity; [ "$PLAYER" = 0 ] && slot=sim build="$build --no-player"
    guard=("$HEAVY" "$slot")
    [ -n "$HEAVY" ] && command -v "$HEAVY" >/dev/null || { guard=(); echo "boat_sim: no heavy guard (${HEAVY:-none}: stack.yaml heavy or BOAT_SIM_HEAVY); running directly" >&2; }
    ( setsid "${guard[@]}" "$0" _run --seed "$SEED" $build >"$RUN/session.log" 2>&1 & echo $! >"$RUN/queued.pid" )
    echo "boat_sim: queued for the heavy $slot slot; log $RUN/session.log; when ready: tmux -L boat attach -t $SIM_TMUX_SESSION"
    ;;
  _run) session ;;
  down) down ;;
  status)
    echo "domain: $(cat "$RUN/domain" 2>/dev/null || echo none)"
    [ -s "$RUN/player.pid" ] && kill -0 "$(cat "$RUN/player.pid")" 2>/dev/null && echo "player: running" || echo "player: stopped"
    t has-session -t "=$SIM_TMUX_SESSION" 2>/dev/null && echo "tui: tmux -L boat attach -t $SIM_TMUX_SESSION" || echo "tui: none"
    ;;
  *) sed -n '2,12s/^# \{0,1\}//p' "$0"; [ -z "$verb" ] || exit 2 ;;
esac
